-- script para criar uma tabela agregada e enriquecida na camada refined
config {
  type: "table",
  name: "ref_acompanhamento_telemetria",
  schema: "refined",
  tags: ["refined", "telemetria", "agregacao", "enriquecimento"],
  description: "Dados de telemetria agregados e enriquecidos com eventos de manutenção"
}

-- CTE para agregar os dados de telemetria por dia
with telemetria_diaria as (
  select
    date(hora_registro_sensor) as data_leitura,
    safe_cast(equipamento as string) as equipamento,
    safe_cast(sensor as string)    as sensor,
    avg(safe_cast(valor as float64)) as media_valor,
    min(safe_cast(valor as float64)) as min_valor,
    max(safe_cast(valor as float64)) as max_valor,
    count(safe_cast(valor as float64)) as contagem_leituras
  from
    ${ref("trusted", "tru_telemetria")}
  where
    valor is not null and hora_registro_sensor is not null
  group by
    1, 2, 3
),

-- CTE para selecionar todos os dados de manutenção
manutencao as (
  select
    *
  from
    ${ref("trusted", "tru_manutencao")}
)

-- FULL OUTER JOIN para combinar os dois conjuntos de dados
select
  coalesce(t1.data_leitura, date(t2.data_inicio)) as data_leitura,
  coalesce(t1.equipamento, t2.equipamento) as equipamento,
  t1.sensor,
  t1.media_valor,
  t1.min_valor,
  t1.max_valor,
  t1.contagem_leituras,
  t2.id_manutencao,
  t2.tipo_manutencao,
  t2.descricao_evento,
  case when t2.id_manutencao is not null then true else false end as teve_manutencao
from
  telemetria_diaria as t1
full outer join
  manutencao as t2
on
  t1.equipamento = t2.equipamento
  and t1.data_leitura = date(t2.data_inicio)